{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ejecutar archivo C# actual",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\debug-current-file.ps1",
        "-FilePath",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Ejecutar SQL Runner",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\sql-runner.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": []
    },
    {
      "label": "ASP: Preparar terminal (cd automÃ¡tico)",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -NoExit -File \"${workspaceFolder}\\.vscode\\preparar-terminal-asp.ps1\" -FilePath \"${file}\"",
      "options": {
        "cwd": "${fileDirname}"
      },
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "new",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
